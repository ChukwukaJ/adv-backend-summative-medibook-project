// Paste into https://dbdiagram.io to view/edit the same design interactively.
Table patients {
  id int [pk, increment, note: 'INT UNSIGNED']
  full_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  phone varchar(20) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table doctors {
  id int [pk, increment, note: 'INT UNSIGNED']
  full_name varchar(100) [not null]
  specialty varchar(100) [not null]
  consultation_fee decimal(10,2) [not null, note: 'CHECK (consultation_fee >= 0)']
  room varchar(20) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table appointments {
  id int [pk, increment, note: 'INT UNSIGNED']
  patient_id int [not null, ref: > patients.id]
  doctor_id int [not null, ref: > doctors.id]
  appointment_datetime datetime [not null, note: '30-minute boundary, 09:00-16:30']
  status enum('booked','cancelled') [not null, default: 'booked']
  amount_paid decimal(10,2) [not null]
  refund_amount decimal(10,2) [not null, default: 0]
  booked_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  cancelled_at datetime [null]
  active_slot datetime [note: "STORED generated: IF(status='booked', appointment_datetime, NULL)"]

  indexes {
    (doctor_id, active_slot) [unique, name: 'uq_doctor_active_slot', note: 'a doctor cannot have two booked appointments at the same date/time']
    (doctor_id, appointment_datetime) [name: 'idx_appointments_doctor_datetime']
  }
}
