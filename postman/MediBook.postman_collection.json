    {
      "name": "5. Waitlist and worker (needs npm run worker)",
      "item": [
        {
          "name": "Find the fully booked day",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const full = pm.response.json().busyDays.find((d) => d.bookedAppointments >= 12);",
                  "pm.test('a full day exists', () => pm.expect(full).to.exist);",
                  "pm.collectionVariables.set('fullDoctorId', full.doctorId);",
                  "pm.collectionVariables.set('fullDay', full.date.slice(0, 10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/busy-days",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "busy-days"
              ]
            }
          }
        },
